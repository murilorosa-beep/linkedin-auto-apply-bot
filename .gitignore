.env.*
*.session
*.cookies

# SQLite Database & Runtime Logs
data/jobs.db
data/applications.db
data/bot.log
data/*.db
data/*.log
*.sqlite
*.sqlite3

# Temporary / Scratch scripts
scratch/

# OS specific files
Thumbs.db
Desktop.ini
.DS_Store
